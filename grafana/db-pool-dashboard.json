{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "gauge",
      "name": "Gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "graph",
      "name": "Time Series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    }
  ],
  "id": null,
  "title": "Database Connection Pool Dashboard",
  "description": "Monitors the health and performance of the database connection pool with alerting thresholds",
  "tags": ["db-pool", "postgres", "monitoring"],
  "timezone": "browser",
  "editable": true,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Pool Utilization %",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "minVizHeight": 75,
        "maxVizHeight": 300,
        "minVizWidth": 75,
        "maxVizWidth": 300,
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "db_pool_active_connections / db_pool_total_connections",
          "legendFormat": "Utilization",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active vs Idle Connections",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "options": {
        "legend": {
          "show": true,
          "values": true,
          "asTable": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max_connections"
            },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "db_pool_active_connections",
          "legendFormat": "Active",
          "interval": "15s"
        },
        {
          "expr": "db_pool_idle_connections",
          "legendFormat": "Idle",
          "interval": "15s"
        },
        {
          "expr": "db_pool_total_connections",
          "legendFormat": "Total",
          "interval": "15s"
        },
        {
          "expr": "db_pool_total_connections",
          "legendFormat": "Max",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 3,
      "title": "Connection Wait Time",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "options": {
        "legend": {
          "show": true,
          "values": true,
          "asTable": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "db_pool_connection_acquire_duration_seconds_sum / db_pool_connection_acquire_duration_seconds_count * 1000",
          "legendFormat": "Avg Wait (ms)",
          "interval": "15s"
        },
        {
          "expr": "db_pool_connection_acquire_duration_seconds_bucket{le=\"0.5\"}",
          "legendFormat": "P50",
          "interval": "15s"
        },
        {
          "expr": "db_pool_connection_acquire_duration_seconds_bucket{le=\"1.0\"}",
          "legendFormat": "P90",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 4,
      "title": "Wait Queue Depth",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "db_pool_wait_queue_depth",
          "legendFormat": "Wait Queue",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 5,
      "title": "Connection Distribution",
      "type": "graph",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 4,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "options": {
        "legend": {
          "show": true,
          "values": true,
          "asTable": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "db_pool_active_connections",
          "legendFormat": "Active",
          "interval": "15s"
        },
        {
          "expr": "db_pool_idle_connections",
          "legendFormat": "Idle",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 6,
      "title": "Alert Status",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "db_pool_alert_level",
          "legendFormat": "Alert Level",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 7,
      "title": "99th Percentile Acquisition Latency",
      "type": "graph",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "options": {
        "legend": {
          "show": true,
          "values": true,
          "asTable": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(db_pool_connection_acquire_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "P99 (ms)",
          "interval": "15s"
        }
      ]
    }
  ],
  "schemaVersion": 36,
  "version": 1,
  "links": [],
  "annotations": {
    "list": []
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "15s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"],
    "now": true
  },
  "templating": {
    "list": []
  }
}
